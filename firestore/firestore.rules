rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidConnectionPayload(peerId) {
      return request.resource.data.peerUid == peerId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.keys().hasAll([
          'peerUid', 'name', 'email', 'fumbledAt'
        ]);
    }

    // Peer updating their own card fields on someone else's connections list
    // (name/photo/share toggles). Does not require re-sending fumbledAt.
    function isValidConnectionProfileSync(peerId) {
      return request.resource.data.peerUid == peerId
        && request.resource.data.name is string
        && request.resource.data.email is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Own private profile. Cross-user discovery uses fumbleCodes.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'name', 'email', 'fumbleCode', 'createdAt', 'lastActiveAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.fumbleCode is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      // Owner may update profile fields but cannot change email identity.
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'fumbleCode', 'createdAt']);

      allow delete: if isOwner(userId);

      match /connections/{peerId} {
        allow read: if isOwner(userId);

        // Owner adds peer card to their own list.
        allow create, update: if isOwner(userId)
          && isValidConnectionPayload(peerId);

        // Peer creates their card on the owner's list (full fumble payload).
        allow create: if isSignedIn()
          && request.auth.uid == peerId
          && isValidConnectionPayload(peerId);

        // Peer updates their own card fields (photo, share toggles, etc.).
        allow update: if isSignedIn()
          && request.auth.uid == peerId
          && isValidConnectionProfileSync(peerId);

        allow delete: if isOwner(userId) || request.auth.uid == peerId;
      }

      match /halfFumbles/{halfId} {
        // Owner can list/query their own half-fumbles (incl. by email).
        allow get, list, create, delete: if isOwner(userId);

        allow update: if isOwner(userId);

        // Invitee may finalize conversion onto the inviter's half-fumble doc.
        allow update: if isSignedIn()
          && isEmailVerified()
          && request.resource.data.connectedUserId == request.auth.uid
          && request.resource.data.status == 'fumbled'
          && resource.data.normalizedEmail == authEmail();
      }
    }

    // Public fumble identity cards used for QR resolve.
    match /fumbleCodes/{code} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Half Fumble invitations — token hash never grants access alone.
    match /invitations/{invitationId} {
      allow create: if isSignedIn()
        && request.resource.data.inviterUserId == request.auth.uid
        && request.resource.data.normalizedEmail is string
        && request.resource.data.tokenHash is string
        && request.resource.data.halfFumbleId is string;

      // Invitee may see/act only after verifying ownership of invited email.
      allow read: if isSignedIn() && (
        resource.data.inviterUserId == request.auth.uid ||
        (isEmailVerified() && resource.data.normalizedEmail == authEmail())
      );

      allow update: if isSignedIn() && (
        resource.data.inviterUserId == request.auth.uid ||
        (
          isEmailVerified()
          && resource.data.normalizedEmail == authEmail()
          && (
            request.resource.data.status == 'pendingAcceptance' ||
            request.resource.data.status == 'declined' ||
            (
              request.resource.data.status == 'fumbled'
              && request.resource.data.acceptedByUserId == request.auth.uid
            )
          )
        )
      );
    }
  }
}
